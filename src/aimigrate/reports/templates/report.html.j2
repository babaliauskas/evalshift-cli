<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>aimigrate · {{ run_id }}</title>
<style>{{ css|safe }}</style>
</head>
<body>
<header class="hdr">
  <h1>AIMigrate report</h1>
  <p class="sub">
    <span class="run-id">{{ run_id }}</span>
    · <span>{{ started_at }}</span>
  </p>
  <table class="meta">
    <tr><th>Source model</th><td><code>{{ source_model }}</code></td></tr>
    <tr><th>Target model</th><td><code>{{ target_model }}</code></td></tr>
    <tr><th>Suite</th><td><code>{{ suite_path }}</code></td></tr>
    <tr><th>Examples</th><td>{{ n_examples }}</td></tr>
    <tr><th>Calls</th><td>{{ n_calls }} ({{ cached_calls }} cached, {{ failed_calls }} failed)</td></tr>
    <tr><th>Total cost</th><td>${{ "%.4f"|format(total_cost_usd) }}</td></tr>
  </table>
</header>

<section>
<h2>Executive summary</h2>
{% if executive_summary %}
<table class="summary">
  <thead><tr>
    <th class="glyph"></th>
    <th>Prompt</th>
    <th>Worst severity</th>
    <th>Slice</th>
    <th class="num">n</th>
    <th class="num">Δ mean</th>
    <th class="num">|d|</th>
    <th class="num">p<sub>corrected</sub></th>
  </tr></thead>
  <tbody>
  {% for row in executive_summary %}
    <tr class="sev-{{ row.severity }}">
      <td class="glyph">{{ severity_glyph(row.severity) }}</td>
      <td><code>{{ row.prompt_id }}</code></td>
      <td>{{ row.severity }}</td>
      <td>{{ row.slice_name }}</td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ "%+.3f"|format(row.delta_mean) }}</td>
      <td class="num">{{ "%.2f"|format(row.effect_size|abs) }}</td>
      <td class="num">{{ "%.3f"|format(row.p_value_corrected) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">No comparisons available.</p>
{% endif %}
</section>

{% for section in prompt_sections %}
<section>
<h2>Prompt: <code>{{ section.prompt_id }}</code></h2>

<h3>Aggregate (slice = "all")</h3>
{% if section.aggregate_rows %}
<table>
  <thead><tr>
    <th>Evaluator</th>
    <th>Test</th>
    <th class="num">n</th>
    <th class="num">Δ mean</th>
    <th class="num">|d|</th>
    <th class="num">95% CI</th>
    <th class="num">p<sub>raw</sub></th>
    <th class="num">p<sub>corrected</sub></th>
    <th>Severity</th>
  </tr></thead>
  <tbody>
  {% for row in section.aggregate_rows %}
    <tr class="sev-{{ row.severity }}">
      <td><code>{{ row.evaluator_name }}</code></td>
      <td>{{ row.test }}</td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ "%+.3f"|format(row.delta_mean) }}</td>
      <td class="num">{{ "%.2f"|format(row.effect_size|abs) }}</td>
      <td class="num">[{{ "%.2f"|format(row.effect_size_ci_low) }}, {{ "%.2f"|format(row.effect_size_ci_high) }}]</td>
      <td class="num">{{ "%.3f"|format(row.p_value) }}</td>
      <td class="num">{{ "%.3f"|format(row.p_value_corrected) }}</td>
      <td>{{ severity_glyph(row.severity) }} {{ row.severity }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">No aggregate comparisons.</p>
{% endif %}

<h3>Slices with significant change</h3>
{% set significant = section.slice_rows|selectattr("severity", "in", ["critical", "high", "medium", "low", "improved"])|list %}
{% if significant %}
<table>
  <thead><tr>
    <th>Slice</th>
    <th>Evaluator</th>
    <th class="num">n</th>
    <th class="num">Δ mean</th>
    <th class="num">|d|</th>
    <th class="num">p<sub>corrected</sub></th>
    <th>Severity</th>
  </tr></thead>
  <tbody>
  {% for row in significant %}
    <tr class="sev-{{ row.severity }}">
      <td>{{ row.slice_name }}</td>
      <td><code>{{ row.evaluator_name }}</code></td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ "%+.3f"|format(row.delta_mean) }}</td>
      <td class="num">{{ "%.2f"|format(row.effect_size|abs) }}</td>
      <td class="num">{{ "%.3f"|format(row.p_value_corrected) }}</td>
      <td>{{ severity_glyph(row.severity) }} {{ row.severity }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">No slices reached significance after BH correction.</p>
{% endif %}

<h3>Top regressions</h3>
{% if section.top_regressions %}
{% for tr in section.top_regressions %}
<div class="regression">
  <div class="reg-head">
    <code>{{ tr.example_id }}</code>
    · <span>{{ tr.evaluator_name }}</span>
    · <span class="delta">Δ {{ "%+.3f"|format(tr.delta) }}</span>
  </div>
  {% if tr.source_trace or tr.target_trace %}
  {# v0.2 — tool regression: render the trace diff in place of text. #}
  <div class="reg-grid">
    <div>
      <h4>Source trace</h4>
      {% if tr.source_trace and tr.source_trace.calls %}
      <ol class="trace-list">
        {% for c in tr.source_trace.calls %}
        <li class="trace-call"><code>{{ c.tool_name }}</code><span class="trace-args">({{ c.arguments|tojson|escape }})</span></li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="trace-empty">(no tool calls)</p>
      {% endif %}
      {% if tr.source_trace and tr.source_trace.final_text %}
      <p class="trace-final"><em>final text:</em> {{ tr.source_trace.final_text|escape }}</p>
      {% endif %}
    </div>
    <div>
      <h4>Target trace</h4>
      {% if tr.target_trace and tr.target_trace.calls %}
      <ol class="trace-list">
        {% set source_names = (tr.source_trace.calls if tr.source_trace else []) | map(attribute='tool_name') | list %}
        {% for c in tr.target_trace.calls %}
        <li class="trace-call {% if c.tool_name in source_names %}trace-match{% else %}trace-extra{% endif %}">
          <code>{{ c.tool_name }}</code><span class="trace-args">({{ c.arguments|tojson|escape }})</span>
        </li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="trace-empty trace-missing">(no tool calls)</p>
      {% endif %}
      {% if tr.target_trace and tr.target_trace.final_text %}
      <p class="trace-final"><em>final text:</em> {{ tr.target_trace.final_text|escape }}</p>
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="reg-grid">
    <div>
      <h4>Source</h4>
      <pre>{{ tr.source_text|escape }}</pre>
    </div>
    <div>
      <h4>Target</h4>
      <pre>{{ tr.target_text|escape }}</pre>
    </div>
  </div>
  {% endif %}
</div>
{% endfor %}
{% else %}
<p class="empty">No specific regressions to surface.</p>
{% endif %}

</section>
{% endfor %}

<section>
<h2>Methodology</h2>
<ul>
{% for note in methodology_notes %}
  <li>{{ note }}</li>
{% endfor %}
</ul>
</section>

<footer>
  <p>Generated by <a href="https://github.com/babaliauskas/AIMigrate">AIMigrate</a>.</p>
</footer>

</body>
</html>
